# LIFELINK OS Root Environment Configuration Example
# Copy to .env for local Docker Compose execution

# Database Configuration
POSTGRES_DB=lifelink
POSTGRES_USER=lifelink
POSTGRES_PASSWORD=lifelink_secure_password_2026
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lifelink
SPRING_DATASOURCE_USERNAME=lifelink
SPRING_DATASOURCE_PASSWORD=lifelink_secure_password_2026

# JWT Authentication
JWT_SECRET=lifelink_production_grade_jwt_secret_key_minimum_256_bits_length_for_hmac_sha256_algorithm_2026
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# AI Provider (Optional: Leave blank to use deterministic offline rules engine)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_FALLBACK_ENABLED=true

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./lifelink-uploads

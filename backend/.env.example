# LIFELINK OS Backend Environment Configuration Example
PORT=8080
SPRING_DATASOURCE_URL=jdbc:h2:mem:lifelinkdb;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER=org.h2.Driver

JWT_SECRET=lifelink_super_secure_jwt_secret_key_minimum_256_bits_length_for_hmac_sha256_algorithm_2026
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: set for live OpenAI assessments. When empty, deterministic fallback engine is engaged automatically.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_FALLBACK_ENABLED=true

STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./lifelink-uploads
